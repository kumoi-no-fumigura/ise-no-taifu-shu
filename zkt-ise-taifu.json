 "blocks": [
  {
   "id": "zkt-ise-taifu-0001",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "忍ぶるなかに物いひ始めたる男つとめてやらむ歌こひしに正月一日",
   "author": "",
   "text": "葦もゆる沼の氷はとけたれどゆく方もなき谷の下水",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0002",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "同じ七日子日にゆきふる",
   "author": "",
   "text": "一人は皆野べの小松を引に行くけさの若菜は雪やつむらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0003",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "かれにける女のもとに紅梅を折りておこせたるに",
   "author": "",
   "text": "紅の色に匂へる梅のはな人あく人のいかでをりけむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0004",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "雲林院の櫻を都のにくらべよとて人のおこせたりしに",
   "author": "",
   "text": "白雲のかゝる山べの櫻花これはこれぞと君に折ける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0005",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "女院の中宮と申しける時內におはしまいしに奈良から僧都のやへ櫻を進らせたるに今年のとりいれ人は今まゐりぞとて紫式部のゆづりしに入道殿さかせ給ひてたヾにはとり入れ日本シティと仰せられしかば",
   "author": "",
   "text": "0古のならの都の八重櫻けふこゝのへに匂ひぬるかな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0006",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "殿の御まへ殿上にとりいださせ給ひて上達め君達ひきつれてよろこびにおはしたりし院の御返し",
   "author": "",
   "text": "。九重に匂ふをみれば櫻狩重ねてきたる春かとぞ思ふ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0007",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "月あかきに院の御まへのおもしろきにとて皇太后宮〓〓の女房たち睦まじき殿上人達に隱されておりたりしにうけのほの〓〓見えしに物いひにやれとおほせられしに",
   "author": "",
   "text": "。浮雲はたち隱せども臨もりて空行く月の影をみる哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0008",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "co浮浮に隠れてとこそ思しか妬くも隙のもりにける哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0009",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "人の心なむうらみてなりにけるときゝて同じ人文おこする返事をせねば",
   "author": "",
   "text": "o.身上に知ずしも非じ人の爲人のつらきはつらき物ぞと",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0010",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "返しみち",
   "author": "",
   "text": "。身身から人のつらきも知ぬれば猶此道に踏見すしがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0011",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ね思はむと思し人と思しに思ひしかともおもほえし哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0012",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "〓。君を我思はざりせば我を君思はむとしも思はましやは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0013",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "三條院の御時院の里におはしましゝ時ごせちに昔おぼえて殿上人ひきつれて參りたりし中に",
   "author": "",
   "text": "x早早みし山ゐの水の上氷打とけさまは變らざりけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0014",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "一條殿のうへ勸修寺にて御堂供養せられしに筆をかりてかへしおこせたりしに",
   "author": "",
   "text": "ね。奥山の高嶺の松をふく風に思ぞ出るそのかみのこと",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0015",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "道まさの中將ゆきふるよ御とのゐしてまかでゝつとめて",
   "author": "",
   "text": "〓けさみつる庭の白雪いかならしよゝを積れる景色也つる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0016",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "一ふりでつる人の心の白雪は氷柱にのみぞ思消ゆめる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0017",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "紫式部きよみづに籠りたりしに參りあひて院の御れうにもろともに御あかし奉りしをみて權の葉にかきておこせたりし",
   "author": "",
   "text": "一心ざし君にかゝぐる燈火のおなじ光にあふが嬉しさ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0018",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "一古の契りも嬉し君がためおなじ光にかげをならべて",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0019",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "松に雪のこほりたりしにつけておなじ人",
   "author": "",
   "text": "一奥山の松には氷る雪よりも我身よにふる程ぞ傳なき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0020",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "きえやすき露の命にくらぶればげに滯る松の雪かな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0021",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "ある人の田舍のかたゑにかきて海のほとりに家有りこれなむ我すむところとありしにかきつく",
   "author": "",
   "text": "本浦近き鹽の庵の柴の戶は人ならずとて浪やたつらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0022",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "雪中竹",
   "author": "",
   "text": "枝撓み雪降つめばなよ竹の末葉も見えず伏返りつゝ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0023",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "一條院うせ給ひてのち難波に君をおはしていみじうなき給ひけることなど人の語るに",
   "author": "",
   "text": "思ひやる哀難波の浦さびて蘆の浮寢はさぞ泣れなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0024",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "お買いせにたてたる寺のかひなむうせにたるとて僧のこひにおこせたるにそへてやりし",
   "author": "",
   "text": "幽なる谷のほらをぞ思やる風のみや吹しく知とふらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0025",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "年頃ありし人のまたしのぶるほどに石山にこもりて音せぬに",
   "author": "",
   "text": "ceみるめ社近江の海に難からぬ吹だに通へしがの浦風",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0026",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "なが月十よ日おなじ寺からいづるに參る人關にあひたり",
   "author": "",
   "text": "一名〓してけふは行なむ野も山も霧隔てたる逢坂の開",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0027",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "世の中さわがしき頃久しうおとせぬに",
   "author": "",
   "text": "〓なき數に思なしてや間ざらむまた有明の月まつ物を",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0028",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "人のもとにゐて人にかはりて",
   "author": "",
   "text": "けけ暮る程待だにも久しきに爭で心をかけて過けむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0029",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "月あかき夜右の大殿の御堂見に人々おはしたり",
   "author": "",
   "text": "によの常に嵐と紛ふ瀧つせの聲ものりとや思なすらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0030",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "〃瀧つせは法の聲にぞ波よりし凉しき風も吹通ひつヽ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0031",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "まさみちの少將ずヾをおきてつとめてとりにおこせたるやるとて",
   "author": "",
   "text": "た人知ぬ思の珠のをとならばなにして逢ぬ數を取まし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0032",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "灌佛の日同じ人",
   "author": "",
   "text": "一諸共に掬びし水はたえにしを何をか灌ぐけふの佛に",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0033",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ル涙をぞけふは佛にそゝぎつる結びし水のたえし計に",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0034",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "玄づかなる有明の月",
   "author": "",
   "text": "加有明の月計りこそ通ひけれくる人なしの宿の庭には",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0035",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "そちのゆかりにて筑紫へくだりにけるむすめに",
   "author": "",
   "text": "〇千年までいきの松原いく君を心つくしに戀や波らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0036",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "「いきの松いきても君に逢〓との久しくならむ程を社思へ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0037",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "人のふみをとりたがへてもてきたりしにそへて",
   "author": "",
   "text": "三などて人浮たる雲の梯をふみ違ふなと〓へざりけむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0038",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "年頃すみし所をたえて外に渡りて又の年の五月五日",
   "author": "",
   "text": "今日もけふ萬蒲も萬蒲變ぬに宿こそ有し宿と覺えね",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0039",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "歌合、さみだれ",
   "author": "",
   "text": "いい計計たごの裳〓もそぼつらむ雲間も見えゐ頃の梅雨",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0040",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "六月のはらへ",
   "author": "",
   "text": "水上も荒ぶる心あらじかし波もなごしの禊しつれば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0041",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "七月七日",
   "author": "",
   "text": "加七夕の夜の衣をきたるよは返す裏をも知せずもがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0042",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "男ある人を年頃思ひ渡りけるにその人なむ物に參りにけると聞きてかねてさがにいきゐて木の葉にかきてとらせけるいへつね",
   "author": "",
   "text": "一奥山の木葉が下の行水は人こそしらねすまぬ物かは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0043",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "これが返事せざりしなむ口をしかりしといもうとの君の語りしかばかの人に代りて",
   "author": "",
   "text": "〓おお積る木葉隠の忘水すむとも見えず絕間のみして",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0044",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "石間ゆく下には通ふ谷水も木葉を繁み上ぞつれなき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0045",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "またかへし",
   "author": "",
   "text": "∞山際さのみ木葉の散積まば石間の水は音だにもなし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0046",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "秋來る人に",
   "author": "",
   "text": "一煙社立ともみえね人しれず戀に焦るゝ秋と知らなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0047",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "、客送ふ秋の空には〓と〓〓にたつとも見えの戀の煙を",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0048",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "こまむかへ",
   "author": "",
   "text": "ひひつつれてくる秋ごとに逢坂の山のは出る望月の駒",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0049",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "つくしにくだりし人にきこえし",
   "author": "",
   "text": "いはねども同じ都はたのまれき哀雲ゐを隔果てつる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0050",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "ある山里に罷りたりしにいへつねがもと近しときゝていひつかはしゝ",
   "author": "",
   "text": "ううさびて葛道懸る山里の家ゐ尊ぬる人もあれかし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0051",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "葛かづらくる人もなき山里は我こそ人を恨果てつれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0052",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "歸る道にひきいれてみしに難波わたり覺えて處のさまいとをかし硯におきし",
   "author": "",
   "text": "ここ枕枕枕旅旅にあかさばや入江の葦の一夜計に",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0053",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "かへしをおしはかりておこせたりしぞをかしか",
   "author": "",
   "text": "人其其草假初にてもあかさなむ長くもあらじ夏の東雲",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0054",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "筑紫につねこと云ふ所にあまの鹽やく所",
   "author": "",
   "text": "ねー秋は露春は霞に立まがひしほやく煙つねことぞみる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0055",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "御住吉詣に",
   "author": "",
   "text": "〓ながらへむ世にも忘れじ住吉の岸に波たつ秋の松風",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0056",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ユ古にふりゆくことぞ哀なる昔ながらの橋をみるにも",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0057",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "院の御菊合に左のとうにて",
   "author": "",
   "text": "長きよの例にうゝる菊の花ゆく末遠く君のみぞみむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0058",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "又",
   "author": "",
   "text": "エめもかれず見つゝ暮さむ菊花菊より後の花し無れば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0059",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "殿のうた合にさくら",
   "author": "",
   "text": "石君が世の遙にみゆる山櫻年にそへてぞ匂ひましける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0060",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "郭公",
   "author": "",
   "text": "聞きつともきかずともなき時鳥心感はすさよの一聲",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0061",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "しか七",
   "author": "",
   "text": "短夕霧に妻惑はせる鹿のねやよるぬる時も驚かるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0062",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "院の白川殿におはしますころ右の大殿もおぼす七ことあるなるにおほとのゐに侍らひたまふつとめてこのはにかきて賜はせたりし",
   "author": "",
   "text": "五世中にふきよるかたもなき物はこのは散ぬる用の風",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0063",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "バス落積るこの山里のこの葉をば返しの風も吹返さなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0064",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "御前にて少納言命婦ことをひきしかば同じ殿とありしかばかやの院の御時うたあはせ、月",
   "author": "",
   "text": "〓君みると空にしればや曇なく萬世をのみてらす月影",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0065",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓昔より名に高砂の松なれば雲の上まで枝ぞさしける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0066",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "千鳥",
   "author": "",
   "text": "行方はさよ深けれど術なくさほの河原は過うかリけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0067",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "いけみづ",
   "author": "",
   "text": "池水のよゝに久しく澄ぬれば底の玉藻も光みえけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0068",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "塵積り床の枕もさびに見戀する人のぬるよなければ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0069",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "れいけい殿の女御のゑ。あはせに、鶴",
   "author": "",
   "text": "禁替替せぬ松のねぐらに群ゐつゝ千年を君に皆讓る也",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0070",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "うの花",
   "author": "",
   "text": "なうの花の咲る垣ねは白波の立田の川の井堰とぞみる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0071",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "皇后宮のみの合た合、月",
   "author": "",
   "text": "臺なき空の鏡とみゆるかな秋のよな〓〓照す月かげ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0072",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "かり",
   "author": "",
   "text": "ハ衣薄み旅のみ空に鳴腫はおのが羽風や夜寒なるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0073",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "山田",
   "author": "",
   "text": "秋秋の夜は山田の庵に稻妻の光のみこそもり明しけれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0074",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "いはひ",
   "author": "",
   "text": "〓〓住のえに生添ふ松の枝ごとに君が千年の數ぞ籠れる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0075",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "同じ宮の東三條の御堂めでたしときゝて舟にてさし渡りしに御まへの方をみやりて、岸の柳",
   "author": "",
   "text": "一靑柳の糸を網手に引卅は岸近くこそよらまほしけれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0076",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "その御堂に殿の御扇にむすびつく",
   "author": "",
   "text": "積るらむ座をも爭で拂はましのりの扇の風の嬉しさ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0077",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "同じ宮に御むすめの御まへにありつるとてちひさき瓜をおこせたりしに",
   "author": "",
   "text": "葉隱ず立も出ばやこまの瓜の其列に社ならま欲けれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0078",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "大納言殿御覽じて御返し",
   "author": "",
   "text": "君をのみこまのゝ瓜と待物を同じ列にも成てみよかし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0079",
   "pid": "873676",
   "pages": [
    57
   ],
   "no": null,
   "kotobagaki": "忝く美しう仰せられたりしかば立ち返り",
   "author": "",
   "text": "夜をつがむ事は更なり敷島の道をさへ社君は知けれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0080",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "うつし賜はせたりしに人の家あり垣ねに梅さきて人きてたてり",
   "author": "",
   "text": "頂ねには寒れて咲けど梅の花匂は人に知せこそすれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0081",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "ふるき家にもみぢ散り蔽ひたり",
   "author": "",
   "text": "古里は時雨の板間もるとてや散紅葉ばを風の吹らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0082",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "しがの大僧正のために九十の賀殿のせさせ給うけるにつゑの歌めせばまゐらする",
   "author": "",
   "text": "萬代を竹の杖にぞ契りつる君し久しくつかむが爲に",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0083",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "が君を所る年の久しくなりぬれば己が榮行杖ぞ好しき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0084",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "院の三條の民都卿の家におはします頃にはかに行幸ありて近き人々の家めされしにそのよしを奏せしかば歌をよみて進らせよと仰せられじかば",
   "author": "",
   "text": "0年つもる即の雲は大空の光にあたるけふぞうれしき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0085",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "いへを返しにすとおほせられたりしゆかりありて東宮の若宮み奉りしにさうしかたの鏡をみて賜はせたる",
   "author": "",
   "text": "一君みれば慶もくもらで萬代の千年をのみもます鏡哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0086",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "返し東宮大夫",
   "author": "",
   "text": "二りりききののまます〓〓も照さむ影に隱れざらめや",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0087",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "なが月のことにや民部卿うへのたきもの合せて試みよとて〓はせたりし",
   "author": "",
   "text": "uああ難難物とこそみれ春咲し梅の匂の秋もかをるは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0088",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "梅枝は焦るゝ秋も匂ひけり春とめ離き物と見しかど",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0089",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "皇后宮から昔のやへ櫻をたまはせて、女房",
   "author": "",
   "text": "これや此ならの都の八重櫻匂わかずもしられざり見",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0090",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "三位うせてかやうのことも尋ねまほしうて",
   "author": "",
   "text": "かあとくれて昔こひしき敷島の道をとふ〓〓尋つる哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0091",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "かやへ葎たえぬる道とみつれども忘れぬ人は尙尋けり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0092",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "以踏通ふ人だになきは敷島の道知ぬ身の憂にぞ有ける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0093",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "又",
   "author": "",
   "text": "石上古野の道の知るべには今日行末も君こそはせめ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0094",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "なりのぶよをそむきしに麻の衣やるとて",
   "author": "",
   "text": "けふとしも思やはせし麻衣涙の玉のかゝるべしとば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0095",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "「思ふにも云にも條る事なれや衣の玉の顯はるゝひは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0096",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "かせ聞えしにそへられたりし",
   "author": "",
   "text": "極樂の蓮の花のひものうへに露の光をそふるけふ哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0097",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ひもの上に蓮の露を結量けば磨ける玉の光こそませ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0098",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "みし月の光なしとや欺くらむ隔る雲に時雨のみして",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0099",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "月影の雲隠れにしこの宿に哀をそふるむら時雨かな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0100",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "同じ人二月十五日のひのいりがたに",
   "author": "",
   "text": "常よりもけふの入日の便にや西を遙に思ひやるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0101",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "けけはいとゝ涙にくれぬ西の山思入日の影を詠めて",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0102",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "同じ日よはばかりに、人",
   "author": "",
   "text": "かいかなればけふしも月のさよ中に照しも果で入しなる覽",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0103",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓を照す月隱れにしさよ中は哀間にやみな迷ひけむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0104",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "又のとし忌にちに",
   "author": "",
   "text": "。別にし其日計りは歸りきといきも歸らぬ人ぞ悲しき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0105",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "思ふ人二人ある男なくなりたるに末の人に代りてもとの人のがりやりし",
   "author": "",
   "text": "。深さこそふぢの袂は優るらめ淚は同じ色にこそしめ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0106",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "むすめのとりこしたるほど久しう見えざりしに",
   "author": "",
   "text": "co垂乳めの親をば捨てゝこはいかに人のこをのみ思ふ我こそ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0107",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "00人のこの親になりてぞ我親の思はいとい思知らるゝ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0108",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "かれ〓〓なる九月ばかりに菊をうゑてなむいぬると聞きしに",
   "author": "",
   "text": "。。のののの行行く人の秋の菊先朝霜にうゑやおきつる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0109",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "わづらひし頃馬頭と云ふ人の度々とひ給ひけるを忘りて後その悅び秋ごろいひやりし",
   "author": "",
   "text": "ooうれしさを思ひおきつゝ忍草わすれぬ物を秋の夕露",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0110",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "xo秋風の音せざりせば白露も軒の葱にかゝるべしやは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0111",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "御せちにいでたる人のもとにある人のいひたり",
   "author": "",
   "text": "coをみ衣重し人や誰ならむ神ならませば我もしなまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0112",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "00日影せしをみの姿はみしかとて山ゐの衣打も重ねず",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0113",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "正月一日こうみたる處にちごのきぬやるとて",
   "author": "",
   "text": "から珍らしく春立初る鶴の子は千世のむ月を重ぬべき哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0114",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "のためにつみたるといへあしに",
   "author": "",
   "text": "。我爲に雲間の若菜摘ければ年返りてぞ好しかりける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0115",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "同じ日うまごのもとから",
   "author": "",
   "text": "一荒玉の年も若菜も摘人は卯杖つきてやのべに出らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0116",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "ニ和杖つき摘まほしきをたゝぃさかに君飛日野の若菜也覺",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0117",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "ふしみせいふ處にて名ある所々歌によむにあしまのいけ",
   "author": "",
   "text": "うう若き蘆間の池の水の色は淺綠にぞ波も立ちける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0118",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "かさとり山",
   "author": "",
   "text": "降らばふれ笠取山の木下は秋の時雨も漏じとぞ思ふ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0119",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "ふしみの里の戀",
   "author": "",
   "text": "盡もせず戀する人はれしいらで伏見の里の夜社長けれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0120",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "語らむと云ふ人の久しく音せぬをつゝじにつけていひやりし",
   "author": "",
   "text": "云やとて云程を待つ岩〓〓〓〓云云すとてやにいはで巳べき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0121",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "又",
   "author": "",
   "text": "一語はで程のへぬれば杜助君忍び音ぞ絕ゆるよもなき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0122",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "五月六日さがみ或る人に",
   "author": "",
   "text": "ヘ人しれす呼待こそ萬滿草昨日を唯にすぐすべしやは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0123",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "返しかはりて",
   "author": "",
   "text": "一萬滿草引く人繁き淀のには何かは深きねをも尋ねむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0124",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "おなじほどの人のいひたる山里に侍るほどこどもの慕ひ詣できて所のさまのをかしきに題にて歌よみ集めたりしを歌合にせむ定めよといひたりしに",
   "author": "",
   "text": "一浦々の波にも我は片寄らじ難波人社あしよしはみめ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0125",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "おなじところ山里の時雨",
   "author": "",
   "text": "一とふ人もなき山里の村時雨ふたよりみより驚かす哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0126",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "人々きくの歌よむをきゝて",
   "author": "",
   "text": "樣々の色をばすてし身なれとも菊に心を移るはす哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0127",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "九月〓日すけみちの大貳のもとから",
   "author": "",
   "text": "二年積る人こそいとヾ惜まるれけふ計りなる秋の夕暮",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0128",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "かへし",
   "author": "",
   "text": "哀かく暮行秋のをしさには立ならぶべき老の波かは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0129",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "思ふことあるころ萩をみて",
   "author": "",
   "text": "へおき明し見つゝ眺むる状の上の然吹亂る秋のよの風",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0130",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "意息を絕絕をむ折は君きても哀いづこと我を尋ねむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0131",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "心息のをのいきて見べき君なれば限る別は有じとぞ思ふ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0132",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "た衣手に推開きてを見備せとうみやうに咲ほうたくの花",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0133",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "coななてのは霜枯るらめど法の內の菊は盛の色ぞ常なる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0134",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "「宿近く逢へる時雨は何なれや山路也せば濡や增まし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0135",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一忍辱の衣をぬへる君なれば感ひをたゝむ驗をぞやる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0136",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "西の方尙とく行むそうかりの衣をぬへる糸に引れて",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0137",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "僧もとからものくむかひにかきたりし",
   "author": "",
   "text": "〓さくししの法を聞つゝ世を救ふ實すの旗と是を云かひ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0138",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "1ふふきしを釋しえさする法のしにもくらの粥を汲て報はむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0139",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "なすびといふものをざるにつくりてかれたる木の枝につけて、人",
   "author": "",
   "text": "想ざる事の樣哉もと茄子からきの枝に成らむ物とは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0140",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "珍しやからきの枝の本茄子作らざるには爭で成けむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0141",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "ふぢのきの舟ににたるに平茸をほしてこれを題にて歌よみてといひたる人に",
   "author": "",
   "text": "〓〓人は鹽木も摘みに岩藤の平茸わたにさしてゆかなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0142",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "はかうせし頃つげずといひて、人",
   "author": "",
   "text": "ね恨ても猶つらき哉廣めけむ法の衣にかけずと思へば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0143",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "chたまさかに弘むる法の衣にも立後れけむみをや恨みぬ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0144",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "よからずや思ふらむと思ふ人のちかうゐたるに",
   "author": "",
   "text": "「夢夢夢心隔つな蘆がきのま近きほどに成ぬとならば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0145",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "かうるといふ遊び所の大和のかみといふ人ぞすみしそれなくなりてふるき難波の里に歸るとてその頃人々歌よみしに",
   "author": "",
   "text": "二ののの裏返りたる難波人ふるの社を懸ぬひやなき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0146",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "おとせぬ人に冬の末つかた",
   "author": "",
   "text": "三忘られて年幕はつる冬草の枯葉は人も尋ねざりけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-ise-taifu-0147",
   "pid": "873676",
   "pages": [
    58
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "嬉しきは千世の小松の遙々と榮始むるいくか也けり",
   "sachu": "",
   "poems": [],
   "jo": ""
  }
